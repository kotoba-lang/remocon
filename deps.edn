;; remocon — learned IR remote-control codes as EDN.
;; Pure .cljc, zero deps. IR hardware transport is host-injected; this repo
;; never touches an IR device.
{:paths ["src"]
 :deps {}
 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-m" "remocon.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
